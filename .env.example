# Angel One SmartAPI Credentials
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_4_digit_pin_here
ANGEL_TOTP_SECRET=your_authenticator_totp_secret_here

# Scanner Engine Configuration
# Options: angelone | mock
DATA_SOURCE=angelone

# Server & Network Configuration
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Scanner Filter Defaults (Optional overrides)
MIN_PCT_CHANGE=0.5
MAX_PCT_CHANGE=20.0
MIN_OI_CHANGE_PCT=5.0
MAX_OI_CHANGE_PCT=500.0
REQUIRE_OPEN_ABOVE_PDH_FOR_GAINERS=true
REQUIRE_OPEN_BELOW_PDL_FOR_LOSERS=true
