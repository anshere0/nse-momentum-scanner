{
  "name": "fo-momentum-scanner",
  "version": "1.0.0",
  "description": "NSE Market Scanner - Live F&O Momentum, PDH/PDL Breakouts, OI Dynamics & Breadth via Angel One SmartAPI",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "node --test server/tests/*.test.js"
  },
  "keywords": [
    "fno",
    "momentum",
    "scanner",
    "angelone",
    "smartapi",
    "nse"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "otplib": "^13.5.0",
    "ws": "^8.22.0",
    "yahoo-finance2": "^4.0.3"
  }
}
