# Pro-Suite Environment Variables
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Data Source Mode: 'live' (reads from localhost:3000 + Angel One) or 'mock' (offline sample data)
DATA_SOURCE=live

# Address of existing live app on same server (DO NOT CHANGE)
PRIMARY_SCANNER_URL=http://localhost:3000

# Optional password protection for /pro (leave blank for open access)
PRO_PASSWORD=

# Polling interval in ms for cash market quotes
CASH_POLL_INTERVAL_MS=15000
